{
  "name": "mirrorgrid",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed-systems reliability laboratory",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "db:migrate": "turbo run db:migrate --filter=@mirrorgrid/db",
    "verify:m0": "node --import tsx tests/gates/verify-m0.ts",
    "verify:m1": "node --import tsx tests/gates/verify-m1.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\""
  },
  "devDependencies": {
    "@types/node": "22.13.9",
    "eslint": "9.22.0",
    "prettier": "3.5.3",
    "tsx": "4.19.3",
    "turbo": "2.10.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
